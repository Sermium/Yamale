{
  "compilerOptions": {
    // Plain TypeScript, no React: this package is the postMessage protocol and
    // the signer built on it, and it has to be usable from an application that
    // is not built with the framework this repository's own interfaces use.
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
