[Unit]
# The JSON-RPC method filter that sits between nginx and CometBFT.
#
# The nginx deny list it replaces matched on the URL path, and CometBFT takes
# the method in the POST body as well — so net_info, dump_consensus_state,
# unconfirmed_txs and broadcast_tx_commit were all answered in full on the
# public funnel while the GET form of each returned 403. nginx cannot read a
# request body without njs or Lua, so the filter is a process.
#
# If this is down the public RPC is down and every console with it, which is
# why it is Requires= rather than Wants= on the node: a gate that fails open
# because the thing behind it went away is not a gate.
Description=Yamale RPC method gate
Documentation=file:///opt/yamale/src/tools/rpcgate/gate.go
After=network-online.target yamale-devnet.service
Wants=network-online.target

# NOT PartOf=yamale-devnet.service, which it used to be.
#
# PartOf propagates stop and restart but never start, so restarting the node
# stopped the gate and left it stopped — and the public /api/rpc/ answered 502
# until somebody noticed. That happened on 2026-09-10, during the recovery from
# the Raspberry Pi going offline, and the RPC stayed down after the chain came
# back.
#
# There is no fail-open risk in letting it outlive the node: with nothing behind
# it the gate refuses, which is the safe direction. A gate that disappears when
# the node restarts is the unsafe one, because what replaces it is nginx
# answering 502 on a path everything depends on.

[Service]
Type=simple
# The service account comes from a per-host drop-in, as the faucet, feeder and
# custodian ones do: the two hosts run these under different logins (the Pi
# under its own, the VM under ubuntu) and there is no shared yamale user on
# either. A User= hard-coded here names an account that exists nowhere and the
# unit fails to start on both hosts, which is what this line used to do.
#
#   /etc/systemd/system/yamale-rpcgate.service.d/user.conf
#   [Service]
#   User=<the account the node runs as on this host>
ExecStart=/opt/yamale/bin/rpcgate --listen 127.0.0.1:26659 --upstream http://127.0.0.1:26657

Restart=always
RestartSec=2s

# It reads a request body, decides, and forwards. It has no state, no keys and
# nothing to write.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
RemoveIPC=true
ReadWritePaths=

# Deliberately NOT MemoryDenyWriteExecute: the Go runtime this is built with
# writes executable pages at init through cloudflare/base64x, and the resulting
# panic looks like a crash loop rather than a policy. Same trap as the
# custodian service.

# The gate buffers one request body at a time per connection, bounded at 1 MiB
# in the code. This is the second bound, in case that one is ever raised.
MemoryMax=256M
TasksMax=512

StandardOutput=journal
StandardError=journal
SyslogIdentifier=yamale-rpcgate

[Install]
WantedBy=multi-user.target
