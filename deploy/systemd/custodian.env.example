# Per-deployment settings for yamale-custodian.service.
# Install at /etc/yamale/custodian.env.
#
# CUSTODIAN_ROLE is the one setting that must differ between the two
# deployments, and everything else follows from it. custodian on one host,
# recovery on the other — never both on one, and never `device`, which the
# service refuses because the device's share belongs on the device.
#
# The sealing key and the pepper MUST NOT live inside CUSTODIAN_DIR. The service
# refuses to start if either does, because "back up the store directory" is the
# one instruction an operator will certainly follow, and a key inside it makes
# that backup a plaintext copy of every share.
#
# CUSTODIAN_NOTIFY_COMMAND is deliberately absent from this example. Recovery
# refuses to start without one, which is the correct behaviour for a deployment
# that cannot actually reach anybody: a notifier that succeeds without notifying
# is worse than none, because it makes every other rule in the recovery process
# run silently.

CUSTODIAN_ROLE=custodian
CUSTODIAN_DIR=/var/lib/yamale/custodian
CUSTODIAN_SEALING_KEY=/etc/yamale/custodian.key
CUSTODIAN_PEPPER=/etc/yamale/custodian.pepper
CUSTODIAN_LISTEN=127.0.0.1:8099
CUSTODIAN_POOL=4
# Zero means a second factor is required for every signature — and since second
# factors are not built, that means every signature is refused. Set it to a real
# threshold only when there is a second factor to demand.
CUSTODIAN_SECOND_FACTOR_ABOVE=0
